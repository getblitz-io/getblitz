{
  "$schema": "https://v2-8-10.turborepo.dev/schema.json",
  "ui": "stream-with-experimental-timestamps",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "prisma:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^prisma:generate", "^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "build:standalone": {
      "dependsOn": ["^prisma:generate", "^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^prisma:generate", "^dev"],
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [".cache/.prettiercache"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["^topo", "^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "test/**", "vitest.config.ts"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "ui-add": {
      "cache": false,
      "interactive": true
    }
  },
  "globalPassThroughEnv": ["NODE_ENV", "CI", "npm_lifecycle_event"]
}

{
  "extends": "@getblitz/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    "jsx": "preserve",
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["."],
  "exclude": [
    "node_modules",
    ".next",
    ".next-test",
    "dist",
    "playwright-report",
    "test-results"
  ]
}

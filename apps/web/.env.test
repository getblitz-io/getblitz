# Environment overrides for Playwright E2E tests
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=password
DATABASE_NAME=getblitz_test

# Redis URL
REDIS_URL="redis://localhost:6380"

# better-auth configuration
AUTH_SECRET='e2e-test-secret-for-deterministic-sessions-must-be-long'
AUTH_GOOGLE_ID=test_google_client_id
AUTH_GOOGLE_SECRET=test_google_client_secret

# Application configuration
APPLICATION_ENV=test
NODE_ENV=development
ENABLE_WEBSOCKET=false
ENCRYPTION_KEY='0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'
NEXT_PUBLIC_APP_URL=http://localhost:3005
PROJECT_URL=http://localhost:3005
NEXT_PUBLIC_WSS_URL=ws://localhost:3005
PORT=3005


// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Payment Gateway Models (Phase 4)
// =============================================================================

enum Currency {
  EUR
  USDC
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  EXPIRED
}

model User {
  id            String    @id
  name          String    @db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  members     Member[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String? @db.Text

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                          String                       @id
  name                        String                       @db.Text
  slug                        String
  logo                        String?                      @db.Text
  createdAt                   DateTime
  metadata                    String?                      @db.Text
  allowedOrigins              String[]                     @default([])
  members                     Member[]
  invitations                 Invitation[]
  paymentSessions             PaymentSession[]
  webhooks                    OrganizationWebhook[]
  organizationBankConnections OrganizationBankConnection[]
  invoices                    Invoice[]
  customers                   Customer[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @db.Text
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.Text
  role           String?      @db.Text
  status         String       @db.Text
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum BankConnectionStatus {
  PENDING_CONFIG // Created, awaiting provider config
  PENDING_OAUTH // Config saved, awaiting OAuth completion
  CONNECTED // OAuth complete, credentials stored
  DISCONNECTED // Manually disconnected
  EXPIRED // Auto-expired (never completed)
  NEEDS_REAUTH // Token expired, user must re-authorize
}

model OrganizationBankConnection {
  id             String               @id @default(uuid(7)) @db.VarChar(36)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Provider identification (e.g., "qonto", "test-bank")
  providerId     String               @db.VarChar(50)
  // Custom name for this connection (optional, defaults to provider name)
  name           String?              @db.VarChar(255)
  callbackId     String?              @db.VarChar(255)
  // Encrypted provider configuration (clientId, clientSecret, URLs, etc.)
  // Nullable during PENDING_CONFIG state before user submits configuration
  providerConfig String?              @db.Text
  // Encrypted OAuth credentials (accessToken, refreshToken, expiresAt)
  credentials    String?              @db.Text
  // OAuth callback URL used during connection setup (needed for token refresh)
  callbackUrl    String?              @db.Text
  isSandbox      Boolean              @default(false)
  webhookUrl     String?              @db.Text
  webhookSecret  String?              @db.Text
  status         BankConnectionStatus @default(PENDING_CONFIG)
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  bankAccounts BankAccount[]

  @@unique([callbackId, organizationId])
  @@index([organizationId])
  @@index([providerId])
  @@map("organization_bank_account")
}

model OrganizationWebhook {
  id             String       @id @default(uuid(7)) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  webhookUrl    String @db.Text // Global notification endpoint
  webhookSecret String @db.Text // For HMAC signature verification

  // Event subscriptions (which events to notify)
  notifyPaymentSuccess   Boolean @default(true)
  notifyPaymentFailed    Boolean @default(true)
  notifyPaymentExpired   Boolean @default(false)
  notifyPaymentAbandoned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("organization_webhook")
}

enum BankAccountStatus {
  ENABLED
  DISABLED
  BLOCKED
}

// New: Generic bank account configuration

model BankAccount {
  id                           String                     @id @default(uuid(7)) @db.VarChar(36)
  externalAccountId            String // Bank's unique account ID
  accountName                  String // User-friendly name
  accountIban                  String // IBAN
  accountBic                   String // BIC
  currency                     Currency                   @default(EUR)
  isDefault                    Boolean                    @default(false)
  organizationBankConnectionId String
  organizationBankConnection   OrganizationBankConnection @relation(fields: [organizationBankConnectionId], references: [id], onDelete: Cascade)
  metadata                     Json? // IBAN, account ID, etc.
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  status                       BankAccountStatus          @default(ENABLED)

  paymentSessions PaymentSession[]
  invoices        Invoice[]

  @@unique([externalAccountId, organizationBankConnectionId])
  @@unique([accountIban, organizationBankConnectionId])
  @@index([accountIban, organizationBankConnectionId])
  @@map("bank_account")
}

model PaymentSession {
  id                  String        @id @default(uuid(7)) @db.VarChar(36)
  organizationId      String        @db.VarChar(36)
  referenceId         String        @unique @db.VarChar(35)
  merchantReferenceId String?       @db.VarChar(64)
  amountCents         Int
  currency            Currency      @default(EUR)
  amountPaidCents     Int
  amountPaidCurrency  Currency      @default(EUR)
  status              PaymentStatus @default(PENDING)
  expiresAt           DateTime? // Nullable for non-expiring payments
  clientToken         String?       @db.VarChar(255)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  bankAccountId       String        @db.VarChar(36)
  bankAccount         BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  metadata            Json?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  invoice      Invoice?

  @@unique([organizationId, merchantReferenceId])
  @@index([organizationId])
  @@index([referenceId])
  @@index([merchantReferenceId])
  @@map("payment_session")
}

model Transaction {
  id               String            @id @default(uuid(7)) @db.VarChar(36)
  paymentSessionId String            @db.VarChar(36)
  txHash           String            @unique @db.VarChar(255)
  amountCents      Int
  currency         Currency          @default(EUR)
  status           TransactionStatus @default(PENDING)
  customerIban     String?           @db.VarChar(34)
  customerBic      String?           @db.VarChar(11)
  customerName     String?           @db.VarChar(255)
  rawPayload       Json?
  createdAt        DateTime          @default(now())

  paymentSession PaymentSession @relation(fields: [paymentSessionId], references: [id], onDelete: Cascade)

  @@index([paymentSessionId])
  @@map("transaction")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

// Invoice model for shareable invoices with extended payment features

model Invoice {
  id             String        @id @default(uuid(7)) @db.VarChar(36)
  organizationId String        @db.VarChar(36)
  referenceId    String        @unique @db.VarChar(35)
  status         InvoiceStatus @default(DRAFT)

  // Customer information
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?   @db.VarChar(36)

  // Snapshot of customer details at time of invoice creation (in case customer is deleted/changed)
  customerEmail   String? @db.VarChar(255)
  customerName    String? @db.VarChar(255)
  customerAddress String? @db.Text
  customerTaxId   String? @db.VarChar(50) // VAT number, Tax ID, etc.

  // Invoice details
  description   String?   @db.Text
  notes         String?   @db.Text // Additional notes/terms
  dueDate       DateTime?
  invoiceNumber String?   @db.VarChar(50) // Custom invoice number (e.g., INV-2024-001)
  expiresAt     DateTime?

  // Financial details - line items stored as JSON for flexibility
  // Structure: [{ description, quantity, unitPriceCents }]
  lineItems      Json? // Array of line items
  subtotalCents  Int // Sum of line items before tax/discount
  taxRateBps     Int      @default(0) // Tax rate in basis points (e.g., 1900 = 19%)
  taxAmountCents Int      @default(0) // Calculated tax amount
  discountCents  Int      @default(0) // Discount amount in cents
  totalCents     Int      @default(0) // Total amount (subtotal + tax - discount)
  currency       Currency @default(EUR)

  // Security
  passwordHash String? @db.VarChar(255) // bcrypt hash for password protection

  // Payment link
  paymentSessionId String?         @unique @db.VarChar(36)
  paymentSession   PaymentSession? @relation(fields: [paymentSessionId], references: [id], onDelete: Cascade)

  // Organization relation
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId String      @db.VarChar(36)

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([referenceId])
  @@index([customerId])
  @@map("invoice")
}

model Customer {
  id             String       @id @default(uuid(7)) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email   String? @db.VarChar(255)
  name    String? @db.VarChar(255)
  address String? @db.Text
  taxId   String? @db.VarChar(50)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationId])
  @@index([organizationId])
  @@map("customer")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

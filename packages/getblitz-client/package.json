{
  "name": "@getblitz/client",
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/getblitz.umd.cjs",
  "module": "./dist/getblitz.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/getblitz.js",
      "require": "./dist/getblitz.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "vite",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@getblitz/shared-types": "workspace:*",
    "qrcode": "catalog:",
    "socket.io-client": "catalog:"
  },
  "devDependencies": {
    "@getblitz/eslint-config": "workspace:*",
    "@getblitz/prettier-config": "workspace:*",
    "@getblitz/tsconfig": "workspace:*",
    "@types/qrcode": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4"
  },
  "prettier": "@getblitz/prettier-config"
}

{
  "name": "@getblitz/client",
  "version": "0.0.6",
  "description": "Embeddable payment SDK for GetBlitz Payment Gateway - Self-hosted SEPA instant transfers across Europe",
  "author": "GetBlitz <hello@getblitz.io>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/getblitz.umd.cjs",
  "module": "./dist/getblitz.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getblitz-io/getblitz.git",
    "directory": "packages/getblitz-client"
  },
  "homepage": "https://getblitz.io",
  "bugs": {
    "url": "https://github.com/getblitz-io/getblitz/issues"
  },
  "keywords": [
    "payment",
    "gateway",
    "sepa",
    "instant-transfer",
    "open-banking",
    "self-hosted",
    "sdk",
    "embeddable",
    "europe",
    "fintech"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/getblitz-io"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/getblitz.js",
      "require": "./dist/getblitz.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "vite",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@getblitz/shared-types": "^0.0.6",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "7.1.12",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

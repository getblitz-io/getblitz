  "dependencies": {
    "@getblitz/shared-types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@getblitz/eslint-config": "workspace:*",
    "@getblitz/prettier-config": "workspace:*",
    "@getblitz/tsconfig": "workspace:*",
    "@getblitz/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:test"
  },
  "prettier": "@getblitz/prettier-config"
}

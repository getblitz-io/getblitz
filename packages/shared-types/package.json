{
  "name": "@getblitz/shared-types",
  "version": "0.0.7",
  "description": "Shared TypeScript types for GetBlitz Payment Gateway",
  "author": "GetBlitz <hello@getblitz.io>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getblitz-io/getblitz.git",
    "directory": "packages/shared-types"
  },
  "homepage": "https://getblitz.io",
  "bugs": {
    "url": "https://github.com/getblitz-io/getblitz/issues"
  },
  "keywords": [
    "getblitz",
    "payment",
    "types",
    "typescript",
    "sepa"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "peerDependencies": {
    "zod": "^3.24.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
